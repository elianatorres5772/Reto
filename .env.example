# Clave solo en backend. Guía práctica: README_LLM.md.
# El flujo documental funciona sin clave. LLM solo para la API conversacional conservada.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
PORT=3000
HOST=127.0.0.1

# Proveedor, presupuesto y ciclo (valores conservadores por defecto).
LLM_PROVIDER=openai
AGENT_MAX_ITERATIONS=25
LLM_MAX_OUTPUT_TOKENS=500
LLM_MAX_SESSION_TOKENS=100000
LLM_MAX_DAILY_TOKENS=1000000
LLM_TIMEOUT_MS=15000
# Dominio HTTPS exacto si se despliega públicamente; dejar vacío en local.
PUBLIC_ORIGIN=
CHAT_RATE_LIMIT=120
