# Clave solo en backend. Guía práctica: README_LLM.md.
# Sin clave, el chat entiende órdenes por palabras clave y todas las herramientas funcionan.
# Clave de Anthropic (Claude): https://console.anthropic.com/settings/keys
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
PORT=3000
HOST=127.0.0.1

# Presupuesto y ciclo. LLM_MAX_OUTPUT_TOKENS incluye el razonamiento del modelo.
AGENT_MAX_ITERATIONS=25
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_SESSION_TOKENS=100000
LLM_MAX_DAILY_TOKENS=1000000
LLM_TIMEOUT_MS=30000
# Dominio HTTPS exacto si se despliega públicamente; dejar vacío en local.
PUBLIC_ORIGIN=
CHAT_RATE_LIMIT=120
# Fecha simulada para evaluar vigencias de soportes (YYYY-MM-DD, no futura). Vacía: fecha UTC actual.
# Para la defensa: 2026-08-25 deja vigente la cámara de comercio de los fixtures.
FECHA_EVALUACION=
