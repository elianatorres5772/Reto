{
  "name": "registro-proveedor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run module:check && pnpm test && pnpm run demo",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:all": "pnpm run check && pnpm run test:e2e",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "demo:historico": "tsx demo.ts --historico",
    "module": "tsx scripts/build-module.ts",
    "module:check": "tsx scripts/build-module.ts --check"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.18.0",
    "bun": "^1.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.19.0"
}
